<!doctype html><html><head><meta charset="utf-8"/><title>Ticket Dashboard</title><link rel="stylesheet" href="/public/style.css"/></head>
<body>
<div class="container">
  <h1>Discord Ticket Bot Dashboard</h1>
  <% if (user) { %>
    <p>Xin chào <strong><%= user.username %></strong></p>
