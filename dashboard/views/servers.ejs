<!doctype html><html><head><meta charset="utf-8"/><title>Select Server</title><link rel="stylesheet" href="/public/style.css"/></head><body>
<div class="container"><h2>Chọn server để quản lý</h2>
  <ul class="list">
    <% guilds.forEach(g => { %>
      <li><a href="/dashboard/guild/<%= g.id %>"><%= g.name %></a></li>
    <% }) %>
  </ul>
</div>
</body></html>
